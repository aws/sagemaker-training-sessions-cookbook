{
  "role_arn": "arn:aws:iam::ACCOUNT_ID:role/SageMakerRole",
  "model_package_group_arn": "arn:aws:sagemaker:us-west-2:ACCOUNT_ID:model-package-group/cookbook-rl",
  "region": "us-west-2",
  "base_model": "openai/gpt-oss-20b",
  "base_model_arn": "arn:aws:sagemaker:us-west-2:aws:hub-content/SageMakerPublicHub/Model/openai-reasoning-gpt-oss-20b/3.29.0",
  "output_s3_path": "s3://YOUR_BUCKET/sdpo-code/",
  "run_name": "sdpo-code-oss20b",
  "env_type": "code_rl",
  "template": "gpt_oss",
  "reasoning": "medium",
  "loss": "importance_sampling",
  "advantage_mode": "grouped",
  "temperature": 1.0,
  "refresh_every": 1,
  "fb_stream_chunks": 4,
  "max_turns": 1,
  "max_tokens": 8192,
  "num_rollout_workers": 64,
  "code_timeout": 6,
  "format_coef": 0.1,
  "lora_rank": 32,
  "lora_alpha": 64,
  "learning_rate": 1e-05,
  "batch_size": 64,
  "responses_per_prompt": 8,
  "max_steps": 50,
  "save_every": 50,
  "val_code_split": "test",
  "val_max_prompts": 200,
  "val_every": 5,
  "val_examples": 5,
  "val_at_start": true,
  "log_every": 1,
  "distill_method": "sdpo",
  "teacher": "base",
  "sdpo_sibling_solutions": true,
  "sdpo_env_feedback": true,
  "feedback_max_chars": 2000,
  "adv_clip": 5.0,
  "alpha_task": 0.0
}
